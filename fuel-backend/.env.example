# Fuel Backend Environment Variables

# USDA FoodData Central API Key (free: https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY=DEMO_KEY

# OpenAI API Key (for GPT-4 Vision food analysis)
OPENAI_API_KEY=

# Nutritionix API (optional — for restaurant menu items)
# Sign up: https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# Database URL (defaults to local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./fuel.db
